# =====================================================================
# Drona Valley Public School — Environment Variables
# Copy this file to .env.local for local development, and add the same
# keys in the Vercel dashboard (Project → Settings → Environment Variables)
# for production.
#
# Both forms send through the SAME noreply@eldenheights.org SMTP account,
# but the delivered-to address differs:
#   - Registration → admission@eldenheights.org
#   - Contact      → vsp.contact@eldenheights.org
#
# Each email already sets replyTo to the visitor's address, so hitting
# "Reply" in your inbox will reply directly to the parent.
# =====================================================================

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://vsp.eldenheights.org

# ---------------------------------------------------------------------
# FORM 1 — ADMISSIONS / REGISTRATION  (the "Register your child" form)
# Sent from noreply@eldenheights.org, delivered to admission@eldenheights.org
# ---------------------------------------------------------------------
REG_SMTP_HOST=smtp.your-provider.com
REG_SMTP_PORT=465
# "true" for port 465 (SSL), "false" for port 587 (STARTTLS)
REG_SMTP_SECURE=true
REG_SMTP_USER=noreply@eldenheights.org
REG_SMTP_PASS=your-noreply-smtp-password
REG_FROM_EMAIL=noreply@eldenheights.org
REG_TO_EMAIL=admission@eldenheights.org

# ---------------------------------------------------------------------
# FORM 2 — GENERAL CONTACT  (the "Say hello / general enquiry" form)
# Sent from noreply@eldenheights.org, delivered to vsp.contact@eldenheights.org
# ---------------------------------------------------------------------
CONTACT_SMTP_HOST=smtp.your-provider.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=noreply@eldenheights.org
CONTACT_SMTP_PASS=your-noreply-smtp-password
CONTACT_FROM_EMAIL=noreply@eldenheights.org
CONTACT_TO_EMAIL=vsp.contact@eldenheights.org

# =====================================================================
# SUPERADMIN PORTAL  (/portal)
# The portal authenticates against Firebase Authentication. Create the
# superadmin account once in Firebase (Console → Authentication → Users →
# Add user) using the email + password below, then sign in at /portal.
#
# Nothing here is hard-coded in the source — it all comes from these vars.
# The NEXT_PUBLIC_* values are safe to expose to the browser; SUPERADMIN_PASSWORD
# is server-only and is only the value you set for the account in Firebase.
# =====================================================================

# Accounts allowed into the portal. Use either or both — they're merged into
# one allowlist. EMAILS (plural) is a comma/space-separated list; EMAIL
# (singular) adds one more. Any address not listed is rejected.
NEXT_PUBLIC_SUPERADMIN_EMAILS=contact.vsp@eldenheights.org
NEXT_PUBLIC_SUPERADMIN_EMAIL=contact.vsp@eldenheights.org
# The password to set for the account(s) when you create them in Firebase Auth.
# (Not read on the client — never shipped to the browser bundle.)
SUPERADMIN_PASSWORD=Password123

# ---------------------------------------------------------------------
# Firebase project config (Console → Project settings → Your apps → Web app).
# These identify the Firebase project and are safe to expose publicly.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
